{
  "name": "omniproxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "check": "tsc --noEmit",
    "bundle:api": "esbuild serverless/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/index.js",
    "db:migrate": "bun run scripts/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@neondatabase/serverless": "^1.2.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
