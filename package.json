{
  "name": "gemini-key-rotator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "check": "bunx tsc --noEmit",
    "bundle:api": "esbuild serverless/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
