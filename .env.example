# Upstream Gemini base (no trailing slash)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Seed keys (comma or newline separated). Runtime-added keys persist in KV.
GEMINI_API_KEYS=

# Per-key pacing after a successful call. 4000 = 15 RPM free tier.
KEY_RATE_WINDOW_MS=4000
# Cooldown on 429 / RESOURCE_EXHAUSTED
KEY_COOLDOWN_MS=60000
# Cooldown on 5xx
KEY_5XX_COOLDOWN_MS=15000
# Max key attempts per request
MAX_ATTEMPTS=6
# How long to wait for a busy pool before returning 429
MAX_WAIT_MS=8000

DEFAULT_MODEL=gemini-2.5-flash
DEFAULT_TTS_MODEL=gemini-2.5-flash-preview-tts
DEFAULT_VOICE=Kore
SEARCH_MODEL=gemini-2.5-flash

# Bearer clients must present for /v1/* ("" = open)
CLIENT_TOKEN=
# Bearer for /admin/* ("" = admin disabled)
ADMIN_TOKEN=

# Upstash Redis REST (optional). Without it, state is per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
