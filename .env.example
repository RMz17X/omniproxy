# Upstream Gemini base (no trailing slash)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Seed keys (comma or newline separated).
GEMINI_API_KEYS=
# ElevenLabs TTS keys (sk_... format)
ELEVENLABS_API_KEYS=
# whatstoken.ai gateway keys (sk-... format)
WHATSTOKEN_API_KEYS=
# Any provider registered through the console can also be seeded this way:
# <PROVIDER_ID_UPPERCASED>_API_KEYS=key1,key2

# Per-key pacing after a successful call. 4000 = 15 RPM free tier.
KEY_RATE_WINDOW_MS=4000
# Cooldown on 429 / RESOURCE_EXHAUSTED
KEY_COOLDOWN_MS=60000
# Cooldown on 5xx
KEY_5XX_COOLDOWN_MS=15000
# Max key attempts per request
MAX_ATTEMPTS=6
# How long to wait for a busy pool before returning 429
MAX_WAIT_MS=8000

DEFAULT_MODEL=gemini-2.5-flash
DEFAULT_TTS_MODEL=gemini-2.5-flash-preview-tts
DEFAULT_VOICE=Kore
SEARCH_MODEL=gemini-2.5-flash

# Bearer clients must present for /v1/* ("" = open)
CLIENT_TOKEN=
# Bearer for /admin/* ("" = admin disabled)
ADMIN_TOKEN=

# ---------- storage (all optional) ----------
# Postgres connection string (Neon HTTP driver). Unset disables every
# persistence path: the gateway still boots and serves, all state stays in
# process memory. Keys are still seeded from GEMINI_API_KEYS.
DATABASE_URL=
# Per-statement ceiling for one query, milliseconds
DB_QUERY_TIMEOUT_MS=3000
# Flush the usage batch after this long
LEDGER_FLUSH_MS=2000
# Flush the usage batch once it holds this many rows
LEDGER_MAX_ROWS=200
# Rows kept in memory for the live tail view
LEDGER_TAIL_ROWS=500
# How long raw usage_events survive a rollup run
RETENTION_DAYS=30
# Bearer for POST /internal/rollup ("" = route disabled)
ROLLUP_TOKEN=